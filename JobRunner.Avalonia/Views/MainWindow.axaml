<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:JobRunner.Avalonia.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" 
        x:Class="JobRunner.Avalonia.Views.MainWindow"
        x:DataType="vm:MainWindowVM"
		
        Icon="/Assets/avalonia-logo.ico"
        Title="Планировщик заданий"
		
		d:DesignWidth="800" d:DesignHeight="450"
		WindowStartupLocation="CenterScreen"
		Width="1200" Height="800"
		MinHeight="800" MinWidth="1200"
		CornerRadius="10"
		CanResize="True">

	<Grid RowDefinitions="70,*">

		<Grid ColumnDefinitions="Auto,*,300"
			  Margin="10,5,10,15">

			<Button 
				Content="Добавить задачу"
				CornerRadius="10"
				Command="{Binding AddTaskCommand}"
				Width="225" Height="45" 
				FontSize="24"
				FontWeight="Bold"
				Margin="15,10,15,5"/>
			
			<Border Classes="search-container"
					Grid.Column="2">
				<DockPanel>
					<TextBox Classes="search-input"
							 Text="{Binding SearchTaskByNameText}"
							 FontSize="24"
							 Watermark="Поиск по названию"/>
					<Image Classes="search-icon"
						   DockPanel.Dock="Right"
						   Source="avares://JobRunner.Avalonia/Resources/Icons/BaseIcons/Search.png"/>
				</DockPanel>
			</Border>
		
		</Grid>
		
		<Grid Grid.Row="1"
			  ColumnDefinitions="*, 50">

			<ListBox ItemsSource="{Binding Tasks}"
					 Grid.Row="1"
					 Margin="10"
					 Background="Transparent">
				<ListBox.ItemTemplate>
					<DataTemplate>
						<Border Margin="5" Padding="10" CornerRadius="5">
							<StackPanel>
								<TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14"/>
								<TextBlock Text="{Binding ExecutionPath}" FontSize="11" Foreground="#888"/>
								<TextBlock Text="{Binding Arguments}" FontSize="11" Foreground="#666"/>
								<TextBlock Text="{Binding IsRunning, StringFormat='Статус: {0}'}" FontSize="11"/>
							</StackPanel>
						</Border>
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>

		</Grid>
	</Grid>
</Window>
