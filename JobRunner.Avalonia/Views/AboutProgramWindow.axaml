<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" 
		d:DesignWidth="800" d:DesignHeight="450"
        x:Class="JobRunner.Avalonia.AboutProgramWindow"
		MinHeight="300" MinWidth="600"
		Height="300" Width="600"
        Title="О программе">
	
	<Grid>
		<StackPanel HorizontalAlignment="Center"
					VerticalAlignment="Center"
					Width="560">
			<Label Content="JobRunner v0.2.1"
				   FontSize="40"/>
			<Label Content="Автоматизированный планировщик заданий"
				   FontSize="24"/>
			<TextBlock Text="По всем вопросам и предложениям вы можете написать на рабочую почту. Пожалуйста, укажите проект (название) и пожелания"
					   TextWrapping="Wrap"/>
			<TextBox Text="reloadedie@mail.ru"
					 Margin="6"
					 Width="150"/>
		</StackPanel>
	</Grid>
	
</Window>
